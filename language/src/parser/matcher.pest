// matcher.pest

// A digit 0-9
digit = _{ '0'..'9' }

// Boundaries
word_boundary = { "#" }
syllable_boundary = { "$" | "." | "ˌ" | "ˈ" | "'" }

// A valid sound class base is an uppercase English letter, a Greek capital letter, or a Hebrew letter.
sound_class_base = _{ ASCII_ALPHA_UPPER | '\u{0391}'..'\u{03A9}' | '\u{05D0}'..'\u{05EA}' }
subscript = _{ '\u{2080}'..'\u{2089}' }
sound_class = @{ sound_class_base ~ subscript? }

// Optional group: ( ... )
optional_group = { "(" ~ pattern ~ ")" }

// Quantifiers
zero_or_more = { "*" }
one_or_more = { "+" }
quantifier = _{ zero_or_more | one_or_more }

// Feature descriptors (e.g. [+voiced], [-stop], [F +voiced])
feature_sign = { "+" | "-" }
feature_name = @{ ASCII_ALPHA_LOWER+ }
feature_descriptor = { feature_sign ~ feature_name }
feature_class = { "[" ~ sound_class? ~ (" "+)? ~ feature_descriptor ~ (" "+ ~ feature_descriptor)* ~ "]" }

// Sets {a, e, i}, {C, i}
set_element = _{ sound_class | ipa_sequence }
set = { "{" ~ set_element ~ ("," ~ (" "*) ~ set_element)* ~ "}" }

// For IPA characters, anything that isn't a boundary, parens, braces, brackets, quantifier, set separator, or sound class base
ipa_char = _{ !( "#" | "$" | "." | "ˌ" | "ˈ" | "'" | "(" | ")" | "{" | "}" | "[" | "]" | "*" | "+" | "," | sound_class_base | " " | "\t" | "\r" | "\n" ) ~ ANY }
ipa_sequence = @{ ipa_char+ }

// A pattern element is one of the above, optionally followed by a quantifier
base_element = _{ word_boundary | syllable_boundary | feature_class | set | optional_group | sound_class | ipa_sequence }

pattern_element = { base_element ~ quantifier? }

// The entire pattern
pattern = { pattern_element+ }

// Top-level rule
main = { SOI ~ pattern ~ EOI }
