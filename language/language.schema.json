{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/language.schema.json",
  "title": "Language Configuration",
  "description": "Schema for defining a language configuration including phonology and sound classes.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7 identifier for the language"
    },
    "name": {
      "type": "object",
      "properties": {
        "endonym": {
          "type": "string",
          "description": "Endonym in IPA"
        },
        "exonym": {
          "type": "string",
          "description": "Exonym in IPA"
        }
      },
      "required": ["endonym"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp"
        }
      },
      "required": ["created_at"]
    },
    "phonology": {
      "type": "object",
      "properties": {
        "sound_classes": {
          "type": "object",
          "patternProperties": {
            "^[A-Z\u0391-\u03A9\u05D0-\u05EA][\u2080-\u2089]?$": {
              "$ref": "#/$defs/sound_class"
            }
          },
          "additionalProperties": false,
          "description": "Map of sound classes. C, D, L, V are considered present by default."
        },
        "phonotactics": {
          "type": "object",
          "properties": {
            "generators": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/word_generator"
              }
            }
          },
          "required": ["generators"]
        },
        "illegal_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["sound_classes"]
    },
    "sound_changes": {
      "$ref": "#/$defs/sound_changes"
    },
    "derivations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivation"
      }
    }
  },
  "required": ["id", "name", "metadata", "phonology"],
  "$defs": {
    "sound_class": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of string values for the sound class (standard phonemes, modified phonemes, groups, or other classes)"
        },
        "generator": {
          "type": "object",
          "oneOf": [
            {
              "$ref": "#/$defs/generator_config"
            }
          ]
        }
      },
      "required": ["values"]
    },
    "generator_config": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "enum": ["Zipf", "zipf"] },
            "config": {
              "type": "object",
              "properties": {
                "a": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                "b": { "oneOf": [{ "type": "number" }, { "type": "string" }] }
              },
              "required": ["a", "b"]
            }
          },
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "enum": ["Equiprobable", "equiprobable"] }
          },
          "required": ["type"]
        }
      ]
    },
    "word_generator": {
      "type": "object",
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["patterns"],
      "allOf": [
        { "$ref": "#/$defs/generator_config" }
      ]
    },
    "sound_changes": {
      "type": "object",
      "properties": {
        "preamble": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preamble_item"
          }
        },
        "eras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/era_rules"
          }
        }
      }
    },
    "preamble_item": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["full", "match", "transform", "condition"] },
        "changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "value": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "era_rules": {
      "type": "object",
      "properties": {
        "era": { "type": "integer", "minimum": 0 },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sound_change_rule"
          }
        }
      },
      "required": ["era", "rules"]
    },
    "sound_change_rule": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "changes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["changes"]
    },
    "derivation": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "era": { "type": "integer", "minimum": 0 },
        "transforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "from_type": { "type": "string" },
        "to_type": { "type": "string" }
      },
      "required": ["name", "transforms"]
    }
  }
}
